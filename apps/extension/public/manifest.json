{
  "manifest_version": 3,
  "name": "AlgoRhythm · 存储原型",
  "version": "0.2.0",
  "description": "手动记录题目与练习思路。工作台与侧栏共用本地数据，未接入自动采集、AI 或判题。",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "打开 AlgoRhythm 工作台" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; frame-src 'none'" }
}
