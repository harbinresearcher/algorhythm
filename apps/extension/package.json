{
  "name": "@algorhythm/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "check:browser": "node scripts/browser-check.mjs",
    "check:backup-browser": "node scripts/backup-browser-check.mjs",
    "check:manual-browser": "node scripts/manual-browser-check.mjs"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "^6.2.4",
    "playwright": "1.64.0",
    "typescript": "~7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
